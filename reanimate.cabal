cabal-version:      2.0

-- Initial reani.cabal generated by cabal init.  For further documentation,
--  see http://haskell.org/cabal/users-guide/

name:               reanimate
version:            1.1.7.0

-- synopsis:
-- description:
license:            PublicDomain
author:             David Himmelstrup
maintainer:         lemmih@gmail.com
category:           Graphics
synopsis:           Animation library based on SVGs.
homepage:           https://reanimate.github.io
bug-reports:        https://github.com/reanimate/reanimate/issues
build-type:         Simple
extra-source-files:
  ChangeLog.md
  examples/*.hs
  examples/golden/*.golden

extra-doc-files:    docs/gifs/*.gif
description:
  Animation library based on SVGs. Can import (and manipulate) SVGs from
  LaTeX and diagrams. Exports gifs, mp4s, and more. Ships with a webbased
  viewer and auto-reloader.

data-files:
  data/*.jpg
  data/*.svg
  data/CIE_XYZ.csv
  data/CIExyz.csv
  data/cone_sensitivity_lms.csv
  viewer-elm/dist/elm.js
  viewer-elm/dist/index.html
  viewer-elm/dist/style.css

source-repository head
  type:     git
  location: git://github.com/lemmih/reanimate.git

library
  hs-source-dirs:     src

  if os(windows)
    hs-source-dirs: windows

  else
    hs-source-dirs: unix
    build-depends:  unix

  default-extensions:
    PackageImports
    PatternSynonyms

  exposed-modules:
    Geom2D.CubicBezier.Linear
    Reanimate
    Reanimate.Animation
    Reanimate.Blender
    Reanimate.Builtin.CirclePlot
    Reanimate.Builtin.Documentation
    Reanimate.Builtin.Flip
    Reanimate.Builtin.Images
    Reanimate.Builtin.Slide
    Reanimate.Builtin.TernaryPlot
    Reanimate.ColorComponents
    Reanimate.ColorMap
    Reanimate.ColorSpace
    Reanimate.Constants
    Reanimate.Debug
    Reanimate.Ease
    Reanimate.Effect
    Reanimate.External
    Reanimate.GeoProjection
    Reanimate.LaTeX
    Reanimate.Math.Balloon
    Reanimate.Math.Common
    Reanimate.Math.Polygon
    Reanimate.Math.SSSP
    Reanimate.Math.Triangulate
    Reanimate.Memo
    Reanimate.Morph.Common
    Reanimate.Morph.Linear
    Reanimate.Morph.Rotational
    Reanimate.Parameters
    Reanimate.PolyShape
    Reanimate.Povray
    Reanimate.Raster
    Reanimate.Render
    Reanimate.Scene
    Reanimate.Svg
    Reanimate.Svg.BoundingBox
    Reanimate.Svg.Constructors
    Reanimate.Svg.LineCommand
    Reanimate.Svg.Unuse
    Reanimate.Transform
    Reanimate.Transition
    Reanimate.Voice

  other-modules:
    Detach
    Paths_reanimate
    POVRay
    Reanimate.Cache
    Reanimate.Driver
    Reanimate.Driver.Check
    Reanimate.Driver.CLI
    Reanimate.Driver.Daemon
    Reanimate.Driver.Magick
    Reanimate.Driver.Server
    Reanimate.Misc
    Reanimate.Morph.Cache
    Reanimate.Scene.Core
    Reanimate.Scene.Object
    Reanimate.Scene.Sprite
    Reanimate.Scene.Var

  autogen-modules:    Paths_reanimate
  cpp-options:        -DNO_HGEOMETRY
  build-depends:
      aeson
    , ansi-terminal
    , array
    , attoparsec
    , base
    , base64-bytestring
    , bytestring
    , cassava
    , cereal
    , colour
    , containers
    , cryptohash-sha256
    , cubicbezier
    , directory
    , filelock
    , filepath
    , fingertree
    , fsnotify
    , geojson
    , hashable
    , JuicyPixels
    , lens
    , linear
    , matrix
    , mtl
    , neat-interpolation
    , network
    , open-browser
    , optparse-applicative
    , parallel
    , process
    , random
    , random-shuffle
    , reanimate-svg
    , split
    , temporary
    , text
    , time
    , unordered-containers
    , vector
    , vector-space
    , websockets
    , xml

  ghc-options:        -Wall -fno-ignore-asserts

test-suite spec
  type:           exitcode-stdio-1.0
  main-is:        Spec.hs
  other-modules:
    Helpers
    Properties
    TimeVarTests
    UnitTests

  hs-source-dirs: test
  ghc-options:    -w
  cpp-options:    -DNO_HGEOMETRY
  build-depends:
      base
    , bytestring
    , directory
    , filepath
    , linear
    , process
    , QuickCheck              >=2.1.0
    , reanimate
    , tasty
    , tasty-expected-failure
    , tasty-golden
    , tasty-hunit
    , tasty-quickcheck
    , tasty-rerun             >=1.1.17
    , temporary
    , text
    , vector
